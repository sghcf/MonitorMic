<Window x:Class="MonitorMicWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MonitorMic for Windows"
        Width="820" Height="980" MinWidth="700" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#172033" />
        <SolidColorBrush x:Key="Muted" Color="#667085" />
        <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Line" Color="#D9E1EC" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,4,18,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="MonitorMic" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="显示器远场麦克风 → Windows 虚拟麦克风" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="" x:Name="VersionText" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" />
                <TextBlock x:Name="ConnectionText" HorizontalAlignment="Right" Foreground="#667085" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="显示器 IP" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" />
                <TextBox Grid.Column="1" x:Name="IpBox" FontSize="15" MinHeight="34" VerticalContentAlignment="Center" Padding="8,0" />
                <Button Grid.Column="2" x:Name="ConnectButton" Content="连接" Click="ConnectButton_Click" />
                <Button Grid.Column="3" x:Name="HealButton" Content="一键修复并启动" Style="{StaticResource PrimaryButton}" Click="HealButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="电脑依赖" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8" />
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="ADB（电脑端工具）" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="AdbDependencyStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="重新检测" Click="DependencyButton_Click" />
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="VB-CABLE（虚拟声卡）" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="CableDependencyStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="官方安装页" Click="CableButton_Click" />
                    <Button Grid.Column="3" Content="重新检测" Click="DependencyButton_Click" />
                </Grid>
                <TextBlock Text="缺少依赖时只会提示，不会静默安装；安装完成后点击重新检测。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="运行状态" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,8" />
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,6">
                <StackPanel>
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="小爱远场唤醒" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="WakeupStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" x:Name="WakeupButton" Click="WakeupButton_Click" />
                    </Grid>
                    <Separator Background="{StaticResource Line}" />
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="MicStreamer App" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="AppStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" x:Name="AppButton" Content="重新检测" Click="AppButton_Click" />
                    </Grid>
                    <Separator Background="{StaticResource Line}" />
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="串流服务" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="ServiceStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" x:Name="ServiceButton" Click="ServiceButton_Click" />
                    </Grid>
                    <Separator Background="{StaticResource Line}" />
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="音频接收器 → CABLE Input" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="ReceiverStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" x:Name="ReceiverButton" Click="ReceiverButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="4" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="音频输出" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="低延迟模式" HorizontalAlignment="Right" Foreground="#16803C" FontWeight="SemiBold" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="麦克风电平" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ProgressBar Grid.Column="1" x:Name="LevelBar" Height="14" Minimum="0" Maximum="1" Value="0" />
                    <Border Grid.Column="2" x:Name="LiveBadge" Background="#D92D20" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" Visibility="Collapsed">
                        <TextBlock Text="LIVE" Foreground="White" FontWeight="Bold" FontSize="11" />
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="虚拟声卡" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" x:Name="DeviceText" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" x:Name="CableButton" Content="官方安装页" Click="CableButton_Click" />
                    <ComboBox Grid.Column="3" x:Name="GainCombo" Width="104" Margin="12,0,4,0" SelectionChanged="GainCombo_SelectionChanged" />
                    <Button Grid.Column="4" x:Name="ToneButton" Content="播放测试音" Click="ToneButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="显示器端 APK（可选）" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="显示器端 APK 版本与电脑客户端版本独立管理" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="12" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="APK 文件" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Grid.Column="1" x:Name="ApkPathBox" IsReadOnly="True" FontSize="13" Padding="8,5" />
                    <Button Grid.Column="2" Content="选择 APK" Click="ChooseApkButton_Click" />
                </Grid>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock x:Name="ApkSelectionStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="InstallApkButton" Content="安装到显示器并启动" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="InstallApkButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="运行日志" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="仅保留最近 500 条" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="AutoStartCheck" Content="登录后自动启动" Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed" />
                <CheckBox x:Name="AutoHealCheck" Content="断链自动修复" Checked="AutoHealCheck_Changed" Unchecked="AutoHealCheck_Changed" />
            </StackPanel>
            <ListBox Grid.Row="2" x:Name="LogList" Background="#101828" Foreground="#D0D5DD" BorderBrush="#101828" FontFamily="Cascadia Mono,Consolas" FontSize="12" Padding="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
        </Grid>
      </Grid>
    </ScrollViewer>
</Window>
