<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MonitorMic</AssemblyName>
    <RootNamespace>MonitorMicWin</RootNamespace>
    <Version>1.2.4</Version>
    <InformationalVersion>1.2.4</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>MonitorMic</Product>
    <Description>Redmi 显示器麦克风 → Windows 虚拟声卡</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 允许在 macOS/Linux 上交叉构建 Windows 桌面应用 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 单文件发布时把嵌入资源一起打进去 -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <!-- Packaging and local diagnostic projects are separate projects and must
       not be picked up by the SDK's recursive source-file glob. -->
  <ItemGroup>
    <Compile Remove="packaging\**" />
    <EmbeddedResource Remove="packaging\**" />
    <None Remove="packaging\**" />
    <Compile Remove="AudioProbe\**" />
    <EmbeddedResource Remove="AudioProbe\**" />
    <None Remove="AudioProbe\**" />
    <Compile Remove="MainForm.cs" />
    <Compile Remove="LevelMeter.cs" />
</ItemGroup>

</Project>
